++			}
++		}
++		if (vram > 0) return vram;
++	}
++	return 4ull << 30;
++}
++- (NSUInteger)maxBufferLength
++{
++	NSUInteger vram = [self recommendedMaxWorkingSetSize];
++	return vram > (1ull << 30) ? (1ull << 30) : vram;
++}
